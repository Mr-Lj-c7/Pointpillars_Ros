#include "../../include/Pointpillars/pointpillar.h"
#include <iostream>
#include <fstream>
#include <vector>
#include <cuda_runtime.h>
#include "NvInfer.h"
#include "NvOnnxConfig.h"
#include "NvOnnxParser.h"
#include "NvInferRuntime.h"

/**
 * @brief: TRT释放内存资源
 * @fn  ~TRT()
 */
TRT::~TRT(void)
{
  delete(context_);
  delete(engine_);
  checkCudaErrors(cudaEventDestroy(start_));
  checkCudaErrors(cudaEventDestroy(stop_));
  return;
}

/**
 * @brief: onnx转换为Engine进行TensorRT推理
 * @fn  TRT（）
 * @param modelFile: onnx模型文件路径
 * @param stream: 点云数据输入，CUDA流
 * @return: 无
*/
TRT::TRT(std::string modelFile, cudaStream_t stream):stream_(stream)
{
  std::string modelCache = modelFile + ".cache";
  std::fstream trtCache(modelCache, std::ifstream::in);
  checkCudaErrors(cudaEventCreate(&start_));
  checkCudaErrors(cudaEventCreate(&stop_));
  // 无缓存文件，则进行onnx转换，并缓存
  if (!trtCache.is_open())
  {
	  std::cout << "Building TRT engine."<<std::endl;
    // define builder
    auto builder = (nvinfer1::createInferBuilder(gLogger_));  // 创建TensorRT构建器

    // define network
    const auto explicitBatch = 1U << static_cast<uint32_t>(nvinfer1::NetworkDefinitionCreationFlag::kEXPLICIT_BATCH);  // 显式批处理
    auto network = (builder->createNetworkV2(explicitBatch));  // 构建网络

    // define onnxparser
    auto parser = (nvonnxparser::createParser(*network, gLogger_));  // 创建onnx解析器
    if (!parser->parseFromFile(modelFile.data(), static_cast<int>(nvinfer1::ILogger::Severity::kWARNING)))
    {
        std::cerr << ": failed to parse onnx model file, please check the onnx version and trt support op!"
                  << std::endl;
        exit(-1);
    }

    // define config
    auto networkConfig = builder->createBuilderConfig();
#if defined (__arm64__) || defined (__aarch64__)  // arm64/aarch64平台则启用fp16精度，提高模型推理速度 
    networkConfig->setFlag(nvinfer1::BuilderFlag::kFP16);
    std::cout << "Enable fp16!" << std::endl;
#endif
    // set max batch size 1
    builder->setMaxBatchSize(1);
    // set max workspace 1G
    networkConfig->setMaxWorkspaceSize(size_t(1) << 30);
    // 构建TensorRT引擎engine
    engine_ = (builder->buildEngineWithConfig(*network, *networkConfig));

    if (engine_ == nullptr)
    {
      std::cerr << ": engine init null!" << std::endl;
      exit(-1);
    }

    // serialize the engine, then close everything down
    auto trtModelStream = (engine_->serialize());  // 模型序列化
    std::fstream trtOut(modelCache, std::ifstream::out);
    if (!trtOut.is_open())
    {
       std::cout << "Can't store trt cache.\n";
       exit(-1);
    }

    trtOut.write((char*)trtModelStream->data(), trtModelStream->size());  // 缓存序列化后的模型
    trtOut.close();
    trtModelStream->destroy();  // 销毁序列化流 trtModelStream

    networkConfig->destroy();
    parser->destroy();
    network->destroy();
    builder->destroy();

  } else {
	  std::cout << "load TRT cache."<<std::endl;
    char *data;
    unsigned int length;

    // get length of file:
    trtCache.seekg(0, trtCache.end);  // 文件指针移动到文件末尾
    length = trtCache.tellg();        // 文件的总长度
    trtCache.seekg(0, trtCache.beg);  // 文件指针移动到文件开头

    data = (char *)malloc(length);    // 分配内存空间，大小为length 字节
    if (data == NULL ) {
       std::cout << "Can't malloc data.\n";
       exit(-1);
    }

    trtCache.read(data, length);     // 读取文件内容到data中
    // create context
    auto runtime = nvinfer1::createInferRuntime(gLogger_);

    if (runtime == nullptr) {	  std::cout << "load TRT cache0."<<std::endl;
        std::cerr << ": runtime null!" << std::endl;
        exit(-1);
    }
    //plugin_ = nvonnxparser::createPluginFactory(gLogger_);
    engine_ = (runtime->deserializeCudaEngine(data, length, 0));  // 从缓存文件数据中反序列化 TensorRT 引擎 engine_
    if (engine_ == nullptr) {
        std::cerr << ": engine null!" << std::endl;
        exit(-1);
    }
    free(data);         // 释放内存空间
    trtCache.close();   // 关闭缓存文件
  }

  context_ = engine_->createExecutionContext();  // 用于执行 TensorRT 引擎 engine_ 的上下文 context_ (执行推理)
  return;
}

/**
 * @brief: TensorRT推理
 * @param buffers: TRT推理的输入输出指针数组,在gpu上分配内存
 * @return: 0: 成功，其他：失败
 */
int TRT::doinfer(void**buffers)  
{
  int status;

  status = context_->enqueueV2(buffers, stream_, &start_);  // 输入和输出数据缓冲区(buffer)传递给推理引擎，并指定 CUDA 流和启动标志

  if (!status)
  {
      return -1;
  }

  return 0;
}

PointPillar::PointPillar(std::string modelFile, cudaStream_t stream):stream_(stream)
{ 
  // create cuda events 用于记录时间戳，方便后续性能分析
  checkCudaErrors(cudaEventCreate(&start_));
  checkCudaErrors(cudaEventCreate(&stop_));

  pre_.reset(new PreProcessCuda(stream_));    // 点云数据预处理
  trt_.reset(new TRT(modelFile, stream_));    // TRT推理
  post_.reset(new PostProcessCuda(stream_));  // 目标检测后处理

  //point cloud to voxels
  voxel_features_size_ = MAX_VOXELS * params_.max_num_points_per_pillar * 4 * sizeof(float);
  voxel_num_size_ = MAX_VOXELS * sizeof(unsigned int);
  voxel_idxs_size_ = MAX_VOXELS* 4 * sizeof(unsigned int);
  // 分配用于存储体素特征、体素数量和体素索引的内存
  checkCudaErrors(cudaMallocManaged((void **)&voxel_features_, voxel_features_size_));
  checkCudaErrors(cudaMallocManaged((void **)&voxel_num_, voxel_num_size_));
  checkCudaErrors(cudaMallocManaged((void **)&voxel_idxs_, voxel_idxs_size_));
  // 初始化
  checkCudaErrors(cudaMemsetAsync(voxel_features_, 0, voxel_features_size_, stream_));
  checkCudaErrors(cudaMemsetAsync(voxel_num_, 0, voxel_num_size_, stream_));
  checkCudaErrors(cudaMemsetAsync(voxel_idxs_, 0, voxel_idxs_size_, stream_));

  //TRT-input
  features_input_size_ = MAX_VOXELS * params_.max_num_points_per_pillar * 10 * sizeof(float);
  // 分配用于存储 TRT 模型输入的内存
  checkCudaErrors(cudaMallocManaged((void **)&features_input_, features_input_size_));
  checkCudaErrors(cudaMallocManaged((void **)&params_input_, sizeof(unsigned int)));
  // 初始化
  checkCudaErrors(cudaMemsetAsync(features_input_, 0, features_input_size_, stream_));
  checkCudaErrors(cudaMemsetAsync(params_input_, 0, sizeof(unsigned int), stream_));

  //output of TRT -- input of post-process
  cls_size_ = params_.feature_x_size * params_.feature_y_size * params_.num_classes * params_.num_anchors * sizeof(float);      // 类别
  box_size_ = params_.feature_x_size * params_.feature_y_size * params_.num_box_values * params_.num_anchors * sizeof(float);   // 边界框
  dir_cls_size_ = params_.feature_x_size * params_.feature_y_size * params_.num_dir_bins * params_.num_anchors * sizeof(float); // 方向角
  // 分配用于存储 TRT 模型输出（类别、边界框、方向角）的内存
  checkCudaErrors(cudaMallocManaged((void **)&cls_output_, cls_size_));
  checkCudaErrors(cudaMallocManaged((void **)&box_output_, box_size_));
  checkCudaErrors(cudaMallocManaged((void **)&dir_cls_output_, dir_cls_size_));

  //output of post-process
  bndbox_size_ = (params_.feature_x_size * params_.feature_y_size * params_.num_anchors * 9 + 1) * sizeof(float);
  // 分配用于存储后处理输出（边界框）的内存 
  checkCudaErrors(cudaMallocManaged((void **)&bndbox_output_, bndbox_size_));

  res_.reserve(100);
  return;
}

/**
 * @brief: release resource
 * @fn ~PointPillar
 * @return:
 */
PointPillar::~PointPillar(void)
{
  // release
  pre_.reset();
  trt_.reset();
  post_.reset();
  
  // 释放CUDA内存
  checkCudaErrors(cudaFree(voxel_features_));
  checkCudaErrors(cudaFree(voxel_num_));
  checkCudaErrors(cudaFree(voxel_idxs_));

  checkCudaErrors(cudaFree(features_input_));
  checkCudaErrors(cudaFree(params_input_));

  checkCudaErrors(cudaFree(cls_output_));
  checkCudaErrors(cudaFree(box_output_));
  checkCudaErrors(cudaFree(dir_cls_output_));

  checkCudaErrors(cudaFree(bndbox_output_));
  
  // 释放CUDA事件
  checkCudaErrors(cudaEventDestroy(start_));
  checkCudaErrors(cudaEventDestroy(stop_));
  return;
}

/**
 * @brief: do inference
 * @fn doinfer
 * @param: points_data: point cloud data
 * @param: points_size: point cloud size
 * @param: nms_res: output result box
 * @return: 0: success, -1: failed
 */
int PointPillar::doinfer(void*points_data, unsigned int points_size, std::vector<Bndbox> &nms_pred)
{
  #if PERFORMANCE_LOG
    float generateVoxelsTime = 0.0f;
    checkCudaErrors(cudaEventRecord(start_, stream_));  // 记录体素的开始时间
  #endif
    // generate voxels
    pre_->generateVoxels((float*)points_data, 
                          points_size,
                          params_input_,     // pointpillars params input
                          voxel_features_,   // 体素特征
                          voxel_num_,        // 体素数量
                          voxel_idxs_);      // 体素索引

  #if PERFORMANCE_LOG
    checkCudaErrors(cudaEventRecord(stop_, stream_));
    checkCudaErrors(cudaDeviceSynchronize());
    checkCudaErrors(cudaEventElapsedTime(&generateVoxelsTime, start_, stop_));  // 点云体素化时间ms
    unsigned int params_input_cpu;          // 体素数量
    checkCudaErrors(cudaMemcpy(&params_input_cpu, params_input_, sizeof(unsigned int), cudaMemcpyDefault));
    std::cout<<"find pillar_num: "<< params_input_cpu <<std::endl;
  #endif

  #if PERFORMANCE_LOG
    float generateFeaturesTime = 0.0f;
    checkCudaErrors(cudaEventRecord(start_, stream_));
  #endif
    // generate features
    pre_->generateFeatures(voxel_features_,  // 体素特征
                          voxel_num_,        // 体素数量
                          voxel_idxs_,       // 体素索引
                          params_input_,     // pointpillars params input
                          features_input_);  // 特征输入

  #if PERFORMANCE_LOG
    checkCudaErrors(cudaEventRecord(stop_, stream_));
    checkCudaErrors(cudaEventSynchronize(stop_));  // 同步设备
    checkCudaErrors(cudaEventElapsedTime(&generateFeaturesTime, start_, stop_));  // 提取特征时间ms
  #endif

  #if PERFORMANCE_LOG
    float doinferTime = 0.0f;
    checkCudaErrors(cudaEventRecord(start_, stream_));
  #endif
    // TRT inference 包含输入和输出缓冲区的数组 -- 输入特征，体素索引， 参数， 类别输出， 包围框输出， 方向输出
    void *buffers[] = {features_input_, voxel_idxs_, params_input_, cls_output_, box_output_, dir_cls_output_};  
    trt_->doinfer(buffers);  // 推理Eigen
    checkCudaErrors(cudaMemsetAsync(params_input_, 0, sizeof(unsigned int), stream_));  

  #if PERFORMANCE_LOG
    checkCudaErrors(cudaEventRecord(stop_, stream_));
    checkCudaErrors(cudaEventSynchronize(stop_));
    checkCudaErrors(cudaEventElapsedTime(&doinferTime, start_, stop_));  // 推理时间ms
  #endif

  #if PERFORMANCE_LOG
    float doPostprocessCudaTime = 0.0f;
    checkCudaErrors(cudaEventRecord(start_, stream_));
  #endif
    // post process 后处理
    post_->doPostprocessCuda(cls_output_,       // 类别结果
                            box_output_,        // 框结果
                            dir_cls_output_,    // 方向
                            bndbox_output_);    // 最终包围框输出
                            
    checkCudaErrors(cudaDeviceSynchronize());
    float obj_count = bndbox_output_[0];        // 获取检测到的对象数量

    int num_obj = static_cast<int>(obj_count);
    auto output = bndbox_output_ + 1;           // 指向第一个对象的边界框数据。

    for (int i = 0; i < num_obj; i++) {
      auto Bb = Bndbox(output[i * 9],                      // x
                      output[i * 9 + 1],                   // y
                      output[i * 9 + 2],                   // z
                      output[i * 9 + 3],                   // w
                      output[i * 9 + 4],                   // l
                      output[i * 9 + 5],                   // h           
                      output[i * 9 + 6],                   // rt
                      static_cast<int>(output[i * 9 + 7]), // id
                      output[i * 9 + 8]);                  // score
      res_.push_back(Bb);
    }


    nms_cpu(res_, params_.nms_thresh, nms_pred);  // cpu进行非极大值抑制
    res_.clear();

  #if PERFORMANCE_LOG
    checkCudaErrors(cudaDeviceSynchronize());
    checkCudaErrors(cudaEventRecord(stop_, stream_));
    checkCudaErrors(cudaEventSynchronize(stop_));
    checkCudaErrors(cudaEventElapsedTime(&doPostprocessCudaTime, start_, stop_));
    std::cout<<"TIME: generateVoxels: "<< generateVoxelsTime <<" ms." <<std::endl;
    std::cout<<"TIME: generateFeatures: "<< generateFeaturesTime <<" ms." <<std::endl;
    std::cout<<"TIME: doinfer: "<< doinferTime <<" ms." <<std::endl;
    std::cout<<"TIME: doPostprocessCuda: "<< doPostprocessCudaTime <<" ms." <<std::endl;
  #endif
    return 0;
}
